{
	"name": "@ui5-community/jsx-runtime-helloworld",
	"version": "0.0.0",
	"description": "UI5 Application: ui5.community.jsx.helloworld",
	"private": true,
	"author": "UI5 Community",
	"license": "Apache-2.0",
	"engines": {
		"node": ">=22.13.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage",
		"build": "ui5 build --clean-dest",
		"build:opt": "ui5 build self-contained --clean-dest --all",
		"dev": "ui5 serve --port 8080 -o index.html",
		"dev-cdn": "ui5 serve --port 8080 -o index-cdn.html",
		"dev-coverage": "ui5 serve --port 8080 --config ui5-coverage.yaml",
		"start": "npm run dev -- --config ui5-dist.yaml",
		"start-cdn": "npm run dev-cdn -- --config ui5-dist.yaml",
		"ts-typecheck": "tsc --noEmit",
		"lint": "eslint webapp",
		"ui5lint": "ui5lint",
		"test-runner": "ui5-test-runner --url http://localhost:8080/test/testsuite.qunit.html",
		"test-runner-coverage": "ui5-test-runner --url http://localhost:8080/test/testsuite.qunit.html --coverage -ccb 50 -ccf 50 -ccl 50 -ccs 50",
		"test-ui5": "ui5-test-runner --start dev-coverage --start-timeout 60000 --url http://localhost:8080/test/testsuite.qunit.html --coverage -ccb 50 -ccf 50 -ccl 50 -ccs 50",
		"test": "npm run lint && npm run test-ui5"
	},
	"dependencies": {
		"@ui5-community/jsx-runtime": "workspace:^"
	},
	"devDependencies": {
		"@babel/plugin-transform-react-jsx": "^7.29.7",
		"@openui5/types": "~1.148.2",
		"@types/qunit": "^2.19.12",
		"@ui5/cli": "^4.0.57",
		"@ui5/linter": "^1.23.1",
		"babel-plugin-istanbul": "^8.0.0",
		"eslint": "^10.7.0",
		"globals": "^17.7.0",
		"rimraf": "^6.0.1",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.63.0",
		"ui5-middleware-livereload": "^3.3.1",
		"ui5-test-runner": "^5.13.1",
		"ui5-tooling-modules": "3.37.8",
		"ui5-tooling-transpile": "^3.12.0"
	}
}
