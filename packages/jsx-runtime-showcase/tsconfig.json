{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "ui5/community/jsx/runtime",
    "paths": {
      "ui5/community/jsx/showcase/*": ["./webapp/*"],
      "unit/*": ["./webapp/test/unit/*"],
      "integration/*": ["./webapp/test/integration/*"]
    },
    "types": [
      "@openui5/types",
      "@types/qunit",
      "@types/prismjs",
      "@ui5-community/jsx-runtime"
    ]
  },
  "include": ["./webapp/**/*"],
  "exclude": ["./webapp/api"]
}
